# Optional for public portfolio pages. Leave blank for local/CI fallback mode.
# Public Supabase anon/publishable key only; NEVER use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical production origin for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://cdytim.vercel.app

# Server-only. Required to enable the daily keepalive; public pages work without it.
# Generate a random value of at least 32 characters. Do not commit a real value.
CRON_SECRET=

# Optional local project workspace. Ignored in production and when Supabase is configured.
LOCAL_ADMIN_ENABLED=false
# Server-only random secret, minimum 32 characters. Never commit a real value.
LOCAL_ADMIN_SESSION_SECRET=
